# 코드가 실제로 읽는 항목만 둔다. 값이 없으면 괄호 안 기본값을 쓴다.

# ── LLM ────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 메인 모델: 도구 호출 계획·결과 평가·최종 응답 생성 (gpt-5 계열은 temperature를 받지 않음)
ER_MAIN_MODEL=gpt-5-mini
ER_MAIN_REASONING_EFFORT=low
ER_MAIN_MAX_OUTPUT_TOKENS=4000   # 256~16000
ER_MODEL_TIMEOUT=60              # 모델 호출 타임아웃(초), 최대 180

# 분류 모델: 위급도 사전 분류, 프롬프트 인젝션 판별
ER_CLASSIFIER_MODEL=gpt-4o-mini
ER_CLASSIFIER_TEMPERATURE=0
ER_CLASSIFIER_MAX_TOKENS=200

# ── 공공데이터포털 E-Gen 응급의료정보 API ───────────────
EGEN_SERVICE_KEY=your-egen-service-key
# EGEN_BASE_URL=https://apis.data.go.kr/B552657/ErmctInfoInqireService  (기본값)

# ── 카카오 로컬 API (주소 검색을 쓸 때만 필요) ──────────
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# ── 외부 호출 정책 (괄호는 허용 범위, 범위를 벗어나면 기본값) ──
ER_REQUEST_TIMEOUT=5         # 타임아웃(초) 0.1~10
ER_MAX_RETRIES=2             # 재시도 횟수(타임아웃·5xx·429) 0~2
ER_RETRY_BACKOFF=1           # 재시도 백오프(초) 0~1
ER_BED_CACHE_TTL=60          # 병상 조회 캐시 유효시간(초) 1~300
ER_STALE_MINUTES=15          # 이 시간 넘은 병상 정보는 '갱신 지연' 표시 1~15

# 반경 확대 단계(5→10→20→30km), 후보 수(3), 모델 호출 상한(10)은 코드에 고정돼 있다.
# 대화 상태는 InMemorySaver(thread_id=user_id), 프로필은 InMemoryStore를 쓴다. 별도 DB 설정은 없다.
